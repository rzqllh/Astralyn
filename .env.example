# Copy this file to apps/worker/.dev.vars for local Worker development.
# Never commit real secrets, tokens, or private keys.

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173

# Google OAuth callback: http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Required only by the protected release export tooling/endpoint.
INTERNAL_BUILDER_SECRET=
