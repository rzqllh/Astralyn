{
  "name": "@astralyn/worker",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc -b",
    "lint": "eslint src test",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply astralyn-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply astralyn-db --remote",
    "auth:schema:generate": "auth generate --config ./src/auth/schema-config.ts --adapter drizzle --dialect sqlite --output ./src/db/auth-schema.generated.ts --yes",
    "auth:schema:check": "tsx ../../tools/check-auth-schema.ts"
  },
  "dependencies": {
    "@astralyn/shared": "workspace:*",
    "better-auth": "1.7.2",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "auth": "1.7.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.126.0"
  }
}
