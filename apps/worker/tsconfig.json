{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist-types"
  },
  "references": [{ "path": "../../packages/shared" }],
  "include": ["src", "test"]
}
