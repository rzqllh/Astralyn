{
  "name": "astralyn-workspace",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @astralyn/web dev",
    "dev:worker": "pnpm --filter @astralyn/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @astralyn/web test:e2e",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1"
  }
}
