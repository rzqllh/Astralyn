{
  "name": "astralyn-workspace",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @astralyn/web --filter @astralyn/worker dev",
    "dev:worker": "pnpm --filter @astralyn/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test:tools": "tsx --test tools/tests/check-knowledge.test.ts tools/tests/knowledge-benchmark.test.ts tools/tests/asset-pipeline.test.ts tools/tests/export.test.ts",
    "test": "pnpm db:check && pnpm data:check && pnpm assets:check && pnpm test:tools && pnpm -r test",
    "test:e2e": "pnpm --filter @astralyn/web test:e2e",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @astralyn/worker db:generate",
    "db:check": "tsx tools/check-migrations.ts",
    "db:migrate:local": "pnpm --filter @astralyn/worker db:migrate:local",
    "auth:schema:generate": "pnpm --filter @astralyn/worker auth:schema:generate",
    "auth:schema:check": "tsx tools/check-auth-schema.ts",
    "data:check": "tsx tools/check-production-data.ts",
    "assets:sync": "tsx tools/sync-assets.ts",
    "assets:check": "tsx tools/check-assets.ts",
    "knowledge:build": "tsx tools/build-knowledge.ts",
    "knowledge:check": "tsx tools/check-knowledge.ts",
    "knowledge:benchmark": "tsx tools/benchmark-knowledge.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "prettier": "^3.5.2",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.24.1"
  }
}
